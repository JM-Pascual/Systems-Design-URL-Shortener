# Sequence: a note in the cached key lets one reader rebuild it, and a write's DEL cancels that rebuild.
...@_style
...@_icons

title: Tier 4.3 - A note in the key {class: title}

flow: "" {
  shape: sequence_diagram
  c1: Reader C_1 {class: svc}
  c2: Reader C_2 {class: svc}
  writer: Writer {class: svc}
  redis: "Redis, volatile-lfu" {class: [svc; redis]}
  postgres: Postgres {class: [svc; postgres]}

  miss: "GET /{code}, cache miss" {
    c1 -> redis: "GET: nil, then BF.EXISTS"
    c1 -> redis: "SET code note NX PX 2000" {class: critical-path}
    c2 -> redis: "GET: a note, so wait 50 ms"
    c1 -> postgres: SELECT
    c1 -> redis: "SET code url IFEQ note EX 300-310" {class: critical-path}
    c2 -> redis: "GET: the url"
  }

  write: "PATCH /{code} during a rebuild" {
    c1 -> redis: "SET code note NX PX 2000"
    c1 -> postgres: "SELECT: old url"
    writer -> postgres: UPDATE
    writer -> redis: "DEL code: removes the note"
    c1 -> redis: "SET ... IFEQ note: refused" {class: critical-path}
  }

  gone: "No row, or the rebuild fails" {
    c1 -> redis: "DELEX code IFEQ note"
  }
}
