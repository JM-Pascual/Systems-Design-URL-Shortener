# Data flow: coalescing inside the process, keep-alive on hits, jitter on writes.
...@_style
...@_icons
direction: right

title: Tier 4.4 - Singleflight and TTLs {class: title}

client: Client {class: actor}

app: App process {
  class: boundary
  resolve: resolve {class: [svc; rust]}
  singleflight: "Singleflight, one call per code" {class: [svc; critical]}
  rebuild: Rebuild {class: svc}
  job: Bloom job {class: svc}
}

redis: Redis, volatile-lfu {
  class: boundary
  values: Cached URLs {class: [store; redis; critical]}
  lease: "lease:{code}" {class: store}
  filter: Bloom filter {class: store}
}

postgres: Postgres links {class: [store; postgres]}
bucket: Bucket {class: [store; aws-s3]}

client -> app.resolve: "GET /{code}"
app.resolve -> redis.values: "GET, TTL, maybe EXPIRE" {class: critical-path}
app.resolve -> app.singleflight: "miss, passes Bloom filter" {class: critical-path}
app.singleflight -> app.rebuild: first caller only
app.rebuild -> redis.lease: "SET NX, or wait"
app.rebuild -> postgres: SELECT
app.rebuild -> redis.values: "SET, TTL plus jitter"
app.job -> redis.filter: keeps complete {class: async}
app.job -> bucket: uploads snapshots {class: async}
